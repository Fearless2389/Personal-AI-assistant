# ── SERVER (/server/.env) ──────────────────────────────────────
NODE_ENV=development
PORT=3001

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini — Google AI Studio, free (required)
GEMINI_API_KEY=your-gemini-api-key

# Token encryption + OAuth-state signing (required for Calendar)
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_ENCRYPTION_KEY=
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NEXUS_STATE_HMAC_SECRET=

# Google Calendar OAuth (required for the Calendar module)
# GOOGLE_REDIRECT_URI must EXACTLY match the URI registered in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

# Twilio SMS (optional — reminders queue until these are set)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Public base URL for Twilio inbound-webhook signature validation (e.g. your ngrok/https host).
# Leave blank locally — validation is skipped when TWILIO_AUTH_TOKEN is unset.
PUBLIC_BASE_URL=

# WhatsApp Cloud API (optional, Phase 5)
WHATSAPP_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# NOTE: SMS scheduling uses an in-process DB poller (services/scheduler.js).
# No Redis / BullMQ / Upstash is required.

# ── CLIENT (/client/.env) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:3001
